{
  "name": "franconia-notch-trails",
  "private": true,
  "description": "An interactive watercolor isometric map of trails in Franconia Notch",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "data": "node scripts/build-data.mjs",
    "social": "node scripts/social-images.mjs",
    "film": "node scripts/film.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
